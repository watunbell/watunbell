# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- NextAuth ---------------------------------------------------------------
# A random secret: run `openssl rand -base64 32`
NEXTAUTH_SECRET=
# The app's base URL (http://localhost:3000 in dev; your real URL in prod)
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (user sign-in) -------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Sheets (database, via service account) -------------------------
# Google Cloud Console > IAM & Admin > Service Accounts > create key (JSON).
# Enable the Google Sheets API for the project, then SHARE the target sheet
# with this service account email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key on one line, keeping the literal \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The spreadsheet id from its URL: /spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab (worksheet) name that holds the items. Defaults to "Items".
GOOGLE_SHEETS_TAB=Items

# --- Access control ---------------------------------------------------------
# Only Google accounts on this Workspace domain may sign in.
# Public (client-visible) so the sign-in screen can show it.
NEXT_PUBLIC_ALLOWED_DOMAIN=g.swu.ac.th
