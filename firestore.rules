rules_version = '2';

// ---------------------------------------------------------------------------
// DEVELOPMENT RULES — open access so the app + emulator work out of the box.
// DO NOT ship these to production.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read, write: if true;
    }
  }
}

